# AllTalk TTS Development Environment Configuration
# Copy this file to .env for local development

# Python Version
PYTHON_VERSION=3.11
PYTHON_MIN_VERSION=3.9

# Development Settings
DEV_MODE=true
DEBUG=true

# Testing
PYTEST_ADDOPTS=--strict-markers --strict-config -v
PYTEST_COVERAGE_MIN=80

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=structured

# Type Checking
MYPY_STRICT_MODE=false
MYPY_PYTHON_VERSION=3.11

# Code Quality
RUFF_LINE_LENGTH=120
BLACK_LINE_LENGTH=120

# Database (if needed in future)
# DATABASE_URL=sqlite:///./alltalk.db
